DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
CHECKIN_RESET_TIME=00:00
CHECKIN_DB_PATH=data/checkins.sqlite
# true gửi một DM khi hoàn thành cả ba nhiệm vụ trong ngày.
QUEST_COMPLETION_DM=false
LAB_VOICE_CHANNEL_IDS=
LAB_VOICE_SECONDS=120
# any = mọi tin bot thấy, target = một tin và emoji chỉ định.
LAB_REACTION_MODE=any
LAB_REACTION_CHANNEL_ID=
LAB_REACTION_MESSAGE_ID=
LAB_REACTION_EMOJI=
LAB_COMMUNITY_THREAD_ID=
# Cấu hình demo độc lập, cần một public thread. Xem docs/FEATURES.md cho danh sách mở rộng.
LAB_QUEST_POOL=voice,reaction,community
# Dự phòng. Chỉ thêm poll vào danh sách sau khi có bài đang mở.
LAB_POLL_MESSAGE_URL=
LAB_POLL_CLOSES_AT=
# Các biến bên dưới là ID kênh, điền khi dùng lệnh từ app tương ứng.
LAB_WHEAT_TAROT_CHANNEL_ID=
LAB_WHEAT_COINFLIP_CHANNEL_ID=
